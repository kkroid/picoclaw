    {
      "criterion_id": "ac-home",
      "label": "概览展示本月收支",
      "category": "functional",
      "required": true,
      "description": "概览承载单元必须展示收入、支出、结余和最近账单入口。"
    },
    {
      "criterion_id": "ac-entry",
      "label": "记账动作链路完整",
      "category": "functional",
      "required": true,
      "description": "用户可以在记账动作承载单元新增一笔账单，并回看概览与账单集合。"
    },
    {
      "criterion_id": "ac-ledger",
      "label": "账单集合可浏览",
      "category": "functional",
      "required": true,
      "description": "账单集合浏览承载单元按时间倒序显示账单，并展示金额和分类。"
    },
    {
      "criterion_id": "ac-persistence",
      "label": "本地持久化可恢复",
