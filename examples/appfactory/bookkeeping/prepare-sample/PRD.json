{
  "schema_version": "0.1.0",
  "id": "prd-bookkeeping-prepare-sample",
  "version": "0.1.0",
  "status": "draft",
  "title": "轻量记账 App",
  "summary": "为个人用户提供一个只覆盖最小核心流程的 Android 记账应用，围绕收支概览、记账动作和账单集合浏览验证需求整理、PRD 生成、Builder 输入包生成和最小执行链路。",
  "problem_statement": "当前实验阶段需要一条从自然语言需求到 Builder 输入包的最小闭环，用来验证 OneAppFactory 能否把简单记账需求整理成结构化规格，并围绕中性交互承载驱动 Builder 执行最小任务链。",
  "target_users": [
    {
      "user_id": "user-office-worker",
      "label": "个人记账用户",
      "summary": "希望快速记录日常收支，不想维护复杂预算系统。",
      "pain_points": [
        "记录动作过重",
        "很难快速回看最近消费",
        "实验阶段不需要注册登录"
      ]
    },
    {
      "user_id": "user-validator",
      "label": "内部验证人员",
      "summary": "需要一眼看出概览、记账动作和账单集合浏览承载是否已被清晰定义。",
      "pain_points": [
        "输入层散乱",
        "Builder 输入包经常缺上下文"
      ]
    }
  ],
  "core_scenarios": [
    {
      "scenario_id": "scenario-quick-add",
      "title": "快速新增一笔收支",
      "summary": "用户能在数秒内录入金额、分类、日期和备注。",
      "primary_user_refs": [
        "user-office-worker"
      ]
    },
    {
      "scenario_id": "scenario-ledger",
      "title": "查看最近账单",
      "summary": "用户可以按时间顺序浏览最近账单并确认金额与分类。",
      "primary_user_refs": [
        "user-office-worker"
      ]
    },
    {
      "scenario_id": "scenario-summary",
      "title": "查看本月概览",
      "summary": "用户能在概览承载单元看到收入、支出和结余概览。",
      "primary_user_refs": [
        "user-office-worker",
        "user-validator"
      ]
    }
  ],
  "goals": [
    "输出完整 PRD.md 和 PRD.json，覆盖收支概览、记账动作、账单集合浏览三个核心范围。",
    "生成可直接被当前 P0 Builder 链路消费的 builder-input.json。",
    "将任务拆成最小 task bundle，便于后续继续收敛到稳定的 thin executor 主线。"
  ],
  "non_goals": [
    "不做账号体系、云同步、多人协作。",
    "不做应用上架、签名、隐私政策页面。",
    "不做复杂预算、报税、OCR 导入。"
  ],
  "feature_list": [
    {
      "feature_id": "feature-home-summary",
      "title": "收支概览",
      "summary": "在概览承载单元展示本月收入、支出、结余和最近三笔账单。",
      "priority": "p0",
      "required": true,
      "related_scenarios": [
        "scenario-summary"
      ],
      "related_surface_refs": [
        "surface-overview"
      ],
      "acceptance_refs": [
        "ac-home",
        "ac-navigation"
      ]
    },
    {
      "feature_id": "feature-add-entry",
      "title": "记账动作",
      "summary": "支持录入金额、类型、分类、日期和备注，并提交新增账单。",
      "priority": "p0",
      "required": true,
      "related_scenarios": [
        "scenario-quick-add"
      ],
      "related_surface_refs": [
        "surface-mutation"
      ],
      "acceptance_refs": [
        "ac-entry"
      ]
    },
    {
      "feature_id": "feature-ledger",
      "title": "账单集合浏览",
      "summary": "按时间倒序展示账单集合，并支持核对金额和分类。",
      "priority": "p0",
      "required": true,
      "related_scenarios": [
        "scenario-ledger"
      ],
      "related_surface_refs": [
        "surface-collection"
      ],
      "acceptance_refs": [
        "ac-ledger"
      ]
    },
    {
      "feature_id": "feature-local-data",
      "title": "本地数据持久化",
      "summary": "账单数据本地持久化，应用重启后仍能恢复概览与账单集合。",
      "priority": "p1",
      "required": true,
      "related_scenarios": [
        "scenario-quick-add",
        "scenario-ledger",
        "scenario-summary"
      ],
      "related_surface_refs": [
        "surface-overview",
        "surface-collection",
        "surface-mutation"
      ],
      "acceptance_refs": [
        "ac-persistence"
      ]
    }
  ],
  "surface_list": [
    {
      "surface_id": "surface-overview",
      "label": "收支概览承载单元",
      "purpose": "承载本月收支摘要、最近账单回看和主导航入口。",
      "primary_feature_refs": [
        "feature-home-summary",
        "feature-ledger"
      ]
    },
    {
      "surface_id": "surface-mutation",
      "label": "记账动作承载单元",
      "purpose": "承载金额、分类、日期和备注录入，以及保存动作。",
      "primary_feature_refs": [
        "feature-add-entry"
      ]
    },
    {
      "surface_id": "surface-collection",
      "label": "账单集合浏览承载单元",
      "purpose": "承载账单集合浏览、结果核对和回到概览的入口。",
      "primary_feature_refs": [
        "feature-ledger",
        "feature-local-data"
      ]
    }
  ],
  "user_flows": [
    {
      "flow_id": "flow-add-expense",
      "title": "新增支出",
      "steps": [
        {
          "step_id": "step-open-entry-action",
          "title": "从概览承载单元进入记账动作入口",
          "surface_ref": "surface-overview",
          "actor": "个人记账用户",
          "expected_result": "能看到金额和分类输入控件"
        },
        {
          "step_id": "step-fill-entry",
          "title": "填写金额、分类、日期和备注",
          "surface_ref": "surface-mutation",
          "actor": "个人记账用户",
          "expected_result": "录入字段校验通过"
        },
        {
          "step_id": "step-save-entry",
          "title": "保存账单并回看概览与账单集合",
          "surface_ref": "surface-mutation",
          "actor": "个人记账用户",
          "expected_result": "概览承载单元和账单集合浏览承载单元都能看到新增账单"
        }
      ]
    },
    {
      "flow_id": "flow-review-ledger",
      "title": "查看账单集合",
      "steps": [
        {
          "step_id": "step-open-ledger",
          "title": "从概览承载单元进入账单集合浏览",
          "surface_ref": "surface-overview",
          "actor": "个人记账用户",
          "expected_result": "能看到最近账单集合"
        },
        {
          "step_id": "step-confirm-entry",
          "title": "核对账单金额和分类",
          "surface_ref": "surface-collection",
          "actor": "个人记账用户",
          "expected_result": "关键信息易于识别"
        }
      ]
    }
  ],
  "data_entities": [
    {
      "entity_id": "entity-entry",
      "name": "账单记录",
      "fields": [
        {
          "name": "entry_id",
          "type": "string",
          "required": true,
          "description": "账单唯一标识"
        },
        {
          "name": "entry_type",
          "type": "enum[income,expense]",
          "required": true,
          "description": "收入或支出"
        },
        {
          "name": "amount",
          "type": "decimal",
          "required": true,
          "description": "金额"
        },
        {
          "name": "category",
          "type": "string",
          "required": true,
          "description": "分类"
        },
        {
          "name": "occurred_on",
          "type": "date",
          "required": true,
          "description": "发生日期"
        },
        {
          "name": "note",
          "type": "string",
          "required": false,
          "description": "备注"
        }
      ],
      "source": "local_storage"
    },
    {
      "entity_id": "entity-summary",
      "name": "月度汇总",
      "fields": [
        {
          "name": "month",
          "type": "string",
          "required": true,
          "description": "月份标识"
        },
        {
          "name": "income_total",
          "type": "decimal",
          "required": true,
          "description": "本月收入总额"
        },
        {
          "name": "expense_total",
          "type": "decimal",
          "required": true,
          "description": "本月支出总额"
        },
        {
          "name": "balance",
          "type": "decimal",
          "required": true,
          "description": "结余"
        }
      ],
      "source": "derived"
    }
  ],
