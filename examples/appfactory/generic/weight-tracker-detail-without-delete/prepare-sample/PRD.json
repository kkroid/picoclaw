        },
        {
          "name": "note",
          "type": "string",
          "required": false,
          "description": "补充备注"
        }
      ],
      "source": "local_storage"
    }
  ],
  "template_constraints": {
    "stack": "flutter",
    "android_required": true,
    "required_capabilities": [
      "navigation",
      "local-storage",
      "theme",
      "list",
      "detail"
    ],
    "preferred_template_ids": [
      "flutter-open-lite"
    ]
  },
