{
  "schema_version": "0.1.0",
  "id": "prd-weight-tracker-detail-without-delete-sample-001",
  "version": "0.1.0",
  "status": "draft",
  "title": "体重记录 App（只读详情）",
  "summary": "把体重记录需求整理成基于通用中性交互承载 Flutter 模板的 Android MVP 规格，并保留体重、日期、备注和趋势等核心语义。",
  "problem_statement": "generic compile 在映射到 open-lite 骨架前，不能丢失体重、日期、备注和趋势等核心领域语义，否则最终生成物会退化成只有通用 record 壳子的伪成功样本。",
  "target_users": [
    {
      "user_id": "user-builder",
      "label": "体重记录 应用使用者",
      "summary": "需要一个离线可用的个人体重记录工具，用于持续记录并回看变化趋势。",
      "pain_points": [
        "自然语言需求容易在 compile 后丢失体重字段和趋势语义",
        "希望先有稳定骨架，再逐步收口为健康记录产品"
      ]
    },
    {
      "user_id": "user-validator",
      "label": "内部验证人员",
      "summary": "需要快速确认 PRD 与 builder-input 是否同时保留领域语义和中性交互承载约束。",
      "pain_points": [
        "需要确认体重、日期、备注和趋势是否进入结构化 PRD",
        "不能再只验证多页面骨架是否存在"
      ]
    }
  ],
  "core_scenarios": [
    {
      "scenario_id": "scenario-inspect-detail",
      "title": "查看体重详情",
      "summary": "用户可以从概览或历史集合入口进入结果检查入口查看单条体重记录。",
      "primary_user_refs": [
        "user-builder"
      ]
    }
  ],
  "goals": [
    "输出覆盖概览、历史集合、实体变更、结果检查和本地存储的体重记录 PRD 与 builder-input。",
    "保留体重、日期、备注与趋势等核心领域语义，再映射到 flutter-open-lite 中性交互承载骨架。",
    "让后续 Builder 能在不改承载单元绑定的前提下，明确收口为体重记录 app。"
  ],
  "non_goals": [
    "不引入登录、支付、广告、地图、推送、实时通信。",
    "不把远端 API 或自建服务器当作模板基础依赖。",
    "不处理上架、签名或复杂商业化配置。"
  ],
  "feature_list": [
    {
      "feature_id": "feature-record-list",
      "title": "历史记录集合承载单元",
      "summary": "按日期倒序展示历史体重记录，并允许进入结果检查入口。",
      "priority": "p0",
      "required": true,
      "related_scenarios": [
        "scenario-inspect-detail"
      ],
      "related_surface_refs": [
        "surface-collection",
        "surface-inspection"
      ],
      "acceptance_refs": [
        "ac-list",
        "ac-detail"
      ]
    },
    {
      "feature_id": "feature-local-storage",
      "title": "本地持久化",
      "summary": "体重记录 数据本地持久化，应用重启后仍能恢复。",
      "priority": "p1",
      "required": true,
      "related_surface_refs": [
        "surface-collection",
        "surface-inspection"
      ],
      "acceptance_refs": [
        "ac-persistence"
      ]
    }
  ],
  "surface_list": [
    {
      "surface_id": "surface-collection",
      "label": "集合浏览承载单元",
      "purpose": "承载领域记录集合浏览、筛选和结果定位。",
      "primary_feature_refs": [
        "feature-record-list"
      ]
    },
    {
      "surface_id": "surface-inspection",
      "label": "结果检查承载单元",
