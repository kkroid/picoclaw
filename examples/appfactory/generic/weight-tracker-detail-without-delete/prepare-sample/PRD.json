    {
      "criterion_id": "ac-list",
      "label": "历史记录集合承载单元可浏览",
      "category": "functional",
      "required": true,
      "description": "历史集合承载单元必须按日期展示体重记录，并允许进入结果检查入口。"
    },
    {
      "criterion_id": "ac-detail",
      "label": "结果检查入口可达",
