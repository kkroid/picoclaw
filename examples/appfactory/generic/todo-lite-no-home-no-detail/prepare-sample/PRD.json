{
  "schema_version": "0.1.0",
  "id": "prd-todo-lite-no-home-no-detail-sample-001",
  "version": "0.1.0",
  "status": "draft",
  "title": "待办事项 App（无首页无详情）",
  "summary": "把待办事项需求整理成基于通用中性交互承载 Flutter 模板的 Android MVP 规格，并保留待办状态分布与任务字段语义。",
  "problem_statement": "generic compile 在映射到 open-lite 骨架前，不能把待办的状态分布、标题、分类和备注等语义压平成无差别 record。",
  "target_users": [
    {
      "user_id": "user-builder",
      "label": "待办事项 应用使用者",
      "summary": "需要一个离线可用的轻量待办工具，用于管理单一任务闭环。",
      "pain_points": [
        "需求常先以自然语言描述，后续容易丢失待办状态语义",
        "希望在统一模板上保留待办领域文案"
      ]
    },
    {
      "user_id": "user-validator",
      "label": "内部验证人员",
      "summary": "需要快速确认 PRD 与 builder-input 是否同时保留领域语义和中性交互承载约束。",
      "pain_points": [
        "需要确认待办状态分布是否进入 PRD",
        "不能只验证通用 CRUD 骨架是否存在"
      ]
    }
  ],
  "core_scenarios": [
    {
      "scenario_id": "scenario-create-record",
      "title": "创建待办",
      "summary": "用户可以通过实体变更承载单元新建待办，并立即回到概览或集合浏览入口看到结果。",
      "primary_user_refs": [
        "user-builder"
      ]
    }
  ],
  "goals": [
    "输出覆盖概览、集合浏览、实体变更、结果检查和本地存储的待办事项 PRD 与 builder-input。",
    "保留待整理、进行中、已完成等状态语义，再映射到 flutter-open-lite 中性交互承载骨架。",
    "让后续 Builder 能明确收口为待办事项 app，而不是停在中性 seed。"
  ],
  "non_goals": [
    "不引入登录、支付、广告、地图、推送、实时通信。",
    "不把远端 API 或自建服务器当作模板基础依赖。",
    "不处理上架、签名或复杂商业化配置。"
  ],
  "feature_list": [
    {
      "feature_id": "feature-record-list",
      "title": "待办集合浏览承载单元",
      "summary": "按时间顺序展示全部待办，支持按状态筛选，并允许进入结果检查入口。",
      "priority": "p0",
      "required": true,
      "related_surface_refs": [
        "surface-collection"
      ],
      "acceptance_refs": [
        "ac-list"
      ]
    },
    {
      "feature_id": "feature-record-form",
      "title": "待办变更承载单元",
      "summary": "支持新增或编辑待办，并提供标题、分类、状态和备注输入。",
      "priority": "p0",
      "required": true,
      "related_scenarios": [
        "scenario-create-record"
      ],
      "related_surface_refs": [
        "surface-mutation"
      ],
      "acceptance_refs": [
        "ac-form"
      ]
    },
    {
      "feature_id": "feature-local-storage",
      "title": "本地持久化",
      "summary": "待办事项 数据本地持久化，应用重启后仍能恢复。",
      "priority": "p1",
      "required": true,
      "related_scenarios": [
        "scenario-create-record"
      ],
      "related_surface_refs": [
        "surface-collection"
      ],
      "acceptance_refs": [
        "ac-persistence"
      ]
    }
  ],
  "surface_list": [
    {
      "surface_id": "surface-collection",
      "label": "集合浏览承载单元",
      "purpose": "承载领域记录集合浏览、筛选和结果定位。",
      "primary_feature_refs": [
        "feature-record-list"
      ]
    },
    {
