    }
  ],
  "manual_review_points": [
    {
      "point_id": "mrp-domain-wording",
      "summary": "检查待办领域文案是否完整进入 PRD",
      "reason": "待办标题、状态分布和任务字段不能被通用 record 话术覆盖。",
      "owner": "product"
    },
    {
      "point_id": "mrp-entity-fit",
      "summary": "确认领域实体能映射到 open-lite 中性交互承载骨架",
      "reason": "compile 后必须在复用集合浏览和实体变更承载单元的同时保留领域字段。",
      "owner": "engineering"
    }
  ],
  "known_unknowns": [
