  "entities": [
    {
      "entity_id": "entity-habit-record",
      "name": "习惯记录",
      "fields": [
        {
          "name": "habit_record_id",
          "type": "string",
          "required": true,
          "description": "习惯记录唯一标识"
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "习惯标题"
        },
        {
          "name": "category",
          "type": "string",
          "required": true,
          "description": "习惯分类"
        },
        {
          "name": "status",
          "type": "enum[pending,done]",
          "required": true,
          "description": "完成状态"
        },
        {
          "name": "checked_at",
          "type": "date",
          "required": true,
          "description": "打卡时间"
        },
        {
          "name": "note",
          "type": "string",
          "required": false,
          "description": "补充备注"
        }
      ],
      "source": "local_storage"
    },
    {
      "entity_id": "entity-habit-summary",
      "name": "习惯概览摘要",
      "fields": [
        {
          "name": "total_count",
          "type": "int",
          "required": true,
          "description": "习惯记录总数"
        },
        {
          "name": "pending_count",
          "type": "int",
          "required": true,
          "description": "未完成记录数"
        },
        {
          "name": "done_count",
          "type": "int",
          "required": true,
          "description": "已完成记录数"
        }
      ],
      "source": "derived"
    }
  ],
  "summary_metrics": [
    "习惯概览摘要"
  ],
  "domain_copy": {
    "title": "习惯打卡 App（抽屉录入）",
    "summary": "把习惯打卡需求整理成基于通用中性交互承载 Flutter 模板的 Android MVP 规格，并保留完成状态分布与打卡记录语义。",
    "problem_statement": "generic compile 在映射到 open-lite 骨架前，不能把习惯打卡的完成状态分布、打卡记录和时间信息压平成无差别 record。"
  },
  "critical_flows": [
    "创建习惯记录",
    "编辑习惯记录",
    "查看习惯详情",
    "按状态查看习惯记录"
  ],
