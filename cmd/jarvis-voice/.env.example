# jarvis-voice 配置样例
# 启动方式（推荐）：
#   export $(grep -v '^#' .env | tr -d '\r' | xargs)
#   ./jarvis-voice

# ─── 代理绕过（LLM 走 localhost Ollama，不能经过代理） ────────────────────────
# 若 WSL 环境设置了 http_proxy，须将 localhost 加入 NO_PROXY，否则 Ollama 请求会被代理拦截。
NO_PROXY=localhost,127.0.0.1
no_proxy=

# ─── 监听 ──────────────────────────────────────────────────────────────────────
# jarvis-voice WebSocket 监听地址（JarvisCore 连接此地址）
JARVIS_LISTEN=

# ─── picoclaw 配置路径（LLM / 记忆 / MCP 工具） ───────────────────────────────
# 默认读取 ~/.picoclaw/config.json，与 picoclaw 进程共享同一份配置。
# 如需自定义路径：
# PICOCLAW_CONFIG=
# 或指定 picoclaw home 目录（读取其下的 config.json）：
# PICOCLAW_HOME=

# ─── 可选：固定 session_id ──────────────────────────────────────────────────────
# 若设置，所有设备共享同一份对话记忆（单设备调试时方便）。
# 生产环境留空，系统自动以 device_id (MAC) 作 session，实现 per-device 记忆。
# JARVIS_LLM_SESSION=

# ─── ASR 和 TTS 共享凭证（火山引擎同一账号） ────────────────────────────────────────
# 快捷API接入模式：只需填 JARVIS_TOKEN（API Key，UUID格式），JARVIS_APPID 留空。
# 传统App Key模式：JARVIS_APPID=
# 注意：截图的"快捷API接入"是豆包大模型(LLM)凭证，ASR/TTS需在火山语音控制台
# 单独开通应用获取数字AppID + Access Token：https://console.volcengine.com/speech
JARVIS_APPID=
JARVIS_TOKEN=

# ─── ASR（豆包/火山引擎 流式识别） ──────────────────────────────────
JARVIS_ASR_PROVIDER=
JARVIS_ASR_CLUSTER=
# 豆包流式ASR模型2.0(Seed)时长包用 volc.seedasr.sauc.duration
# 豆包流式ASR模型1.0     时长包用 volc.bigasr.sauc.duration
JARVIS_ASR_RESOURCE_ID=
# 可选：单独覆盖 APPID/TOKEN
# JARVIS_ASR_APPID=
# JARVIS_ASR_TOKEN=

# ─── TTS（豆包/火山引擎 语音合成） ─────────────────────────────
JARVIS_TTS_PROVIDER=
JARVIS_TTS_CLUSTER=
# 音色列表参考：https://www.volcengine.com/docs/6561/97465
JARVIS_TTS_VOICE=
# 可选：单独覆盖 APPID/TOKEN
# JARVIS_TTS_APPID=
# JARVIS_TTS_TOKEN=

# ─── LLM（通过 picoclaw 配置，不在此处设置） ──────────────────────────────────
# LLM provider / API key 在 picoclaw 侧的 config.json 中配置。
# picoclaw 同时管理 System Prompt、对话记忆、MCP 工具等。
# 参考：https://github.com/sipeed/picoclaw
