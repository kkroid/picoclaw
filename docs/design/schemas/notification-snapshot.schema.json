{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneappfactory.local/docs/design/schemas/notification-snapshot.schema.json",
  "title": "OneAppFactory Notification Snapshot",
  "description": "workspace/appfactory/notifications/index.json 的最小结构基线。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "items"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notification"
      }
    }
  },
  "$defs": {
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notification_id",
        "type",
        "created_at"
      ],
      "properties": {
        "notification_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "suggested_action": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_category": {
          "type": "string",
          "minLength": 1
        },
        "recommended_resume_mode": {
          "type": "string",
          "minLength": 1
        },
        "requires_human_confirmation": {
          "type": "boolean"
        },
        "requires_preserved_workspace": {
          "type": "boolean"
        },
        "acknowledged": {
          "type": "boolean"
        },
        "acknowledged_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}