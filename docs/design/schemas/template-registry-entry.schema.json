{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picoclaw.local/docs/design/schemas/template-registry-entry.schema.json",
  "title": "PicoClaw Template Registry Entry",
  "description": "模板注册表中的单条模板记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "name",
    "repo_url",
    "pinned_ref",
    "license",
    "stack",
    "android_support",
    "capabilities",
    "build_proof",
    "health_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "repo_url": {
      "type": "string",
      "minLength": 1
    },
    "pinned_ref": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "type": "string",
      "enum": [
        "flutter",
        "react-native",
        "kotlin-compose",
        "other"
      ]
    },
    "android_support": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "network_profile": {
      "type": "string",
      "enum": [
        "offline-friendly",
        "backend-required",
        "unknown"
      ]
    },
    "ui_complexity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "build_proof": {
      "$ref": "#/$defs/proof"
    },
    "test_proof": {
      "$ref": "#/$defs/proof"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "deprecated",
        "blocked"
      ]
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selection_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slot_map": {
      "$ref": "./template-slot-map.schema.json"
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}