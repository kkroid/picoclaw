{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneappfactory.local/docs/design/schemas/task-allocation.schema.json",
  "title": "OneAppFactory Task Allocation",
  "description": "planning-engine 产出的任务分配与文件归属快照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "prd_id",
    "template_id",
    "units"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "prd_id": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taskAllocationUnit"
      }
    }
  },
  "$defs": {
    "taskAllocationUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id",
        "wave"
      ],
      "properties": {
        "allocation_id": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "integer",
          "minimum": 0
        },
        "lane": {
          "type": "string",
          "minLength": 1
        },
        "slot_refs": {
          "description": "当前仍沿用旧字段名，但内部值必须是公共 binding_id，而不是 template-slot-map 里的 slot_id。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "surface_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "screen_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relation_group_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_ownership_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capability_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "behavior_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "task_type": {
          "type": "string",
          "enum": [
            "single_file_edit",
            "dual_file_wiring",
            "analyze_repair",
            "test_repair",
            "closure_repair"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "semantic_intent_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_paths": {
          "$ref": "./builder-input.schema.json#/$defs/pathList"
        },
        "owned_paths": {
          "$ref": "./builder-input.schema.json#/$defs/pathList"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "route_hint": {
          "type": "string",
          "enum": [
            "deterministic",
            "default_model",
            "upgrade_model",
            "strong_model"
          ]
        }
      }
    }
  }
}