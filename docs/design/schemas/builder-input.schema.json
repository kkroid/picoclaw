{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picoclaw.local/docs/design/schemas/builder-input.schema.json",
  "title": "PicoClaw Builder Input Package Manifest",
  "description": "PicoClaw 下发给 Builder/Worker 的输入包主清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "prd_id",
    "template_id",
    "planning_policy",
    "workspace_path",
    "artifact_dir",
    "goal_summary",
    "task_bundle",
    "acceptance_checks",
    "allowed_paths",
    "protected_paths",
    "command_profile",
    "context_files",
    "iteration_budget",
    "token_budget"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "输入包 schema 版本；当前契约仅支持 0.1.0，运行时会显式拒绝未知版本。"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "description": "当前构建任务唯一标识。"
    },
    "prd_id": {
      "type": "string",
      "minLength": 1,
      "description": "PRD 标识。"
    },
    "template_id": {
      "type": "string",
      "minLength": 1,
      "description": "受控模板注册表中的模板标识。"
    },
    "planning_policy": {
      "$ref": "#/$defs/planningPolicy"
    },
    "workspace_path": {
      "type": "string",
      "minLength": 1,
      "description": "Worker 内的独立源码工作区路径。"
    },
    "artifact_dir": {
      "type": "string",
      "minLength": 1,
      "description": "构建产物归档目录。"
    },
    "goal_summary": {
      "type": "string",
      "minLength": 1,
      "description": "当前 Builder 轮次的目标摘要。"
    },
    "task_bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taskBundleItem"
      },
      "description": "当前轮次要完成的任务列表。"
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCheck"
      },
      "description": "当前轮次的验收检查项。"
    },
    "allowed_paths": {
      "$ref": "#/$defs/pathList",
      "description": "允许修改的路径。"
    },
    "protected_paths": {
      "$ref": "#/$defs/pathList",
      "description": "禁止修改的路径。"
    },
    "command_profile": {
      "$ref": "#/$defs/commandProfile"
    },
    "context_files": {
      "$ref": "#/$defs/contextFiles"
    },
    "iteration_budget": {
      "type": "integer",
      "minimum": 1,
      "description": "最大迭代次数。"
    },
    "token_budget": {
      "type": "integer",
      "minimum": 1,
      "description": "最大 token 预算。"
    },
    "human_notes": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manualNote"
          }
        }
      ],
      "description": "人工补充说明，可为纯文本或结构化备注。"
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manualNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "summary"
      ],
      "properties": {
        "note_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "product",
            "brand",
            "engineering",
            "security",
            "compliance",
            "other"
          ]
        }
      }
    },
    "planningPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "stages"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/planningStagePolicy"
          }
        }
      }
    },
    "planningStagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "route"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "requirement_structuring",
            "domain_modeling",
            "task_allocation",
            "acceptance_planning",
            "build_input_projection"
          ]
        },
        "route": {
          "type": "string",
          "enum": [
            "planning_model",
            "decision_model",
            "deterministic"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taskBundleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "category",
        "objective",
        "target_paths",
        "completion_criteria"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "domain",
            "content",
            "storage",
            "screen",
            "summary",
            "flow",
            "validation"
          ]
        },
        "task_type": {
          "type": "string",
          "enum": [
            "single_file_edit",
            "dual_file_wiring",
            "analyze_repair",
            "test_repair",
            "closure_repair"
          ]
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "route_hint": {
          "type": "string",
          "enum": [
            "deterministic",
            "default_model",
            "upgrade_model",
            "strong_model"
          ]
        },
        "allocation_transition": {
          "$ref": "#/$defs/taskAllocationTransition"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "related_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_paths": {
          "$ref": "#/$defs/pathList"
        },
        "output_expectations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "taskAllocationTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id"
      ],
      "properties": {
        "allocation_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_intent_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "screen_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relation_group_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_ownership_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owned_paths": {
          "$ref": "#/$defs/pathList"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "label",
        "stage",
        "required"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "baseline",
            "cheap",
            "heavy",
            "milestone",
            "device",
            "smoke",
            "manual"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_criteria": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "allow_failure": {
          "type": "boolean"
        }
      }
    },
    "commandProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_name",
        "allowed_stages",
        "network_policy"
      ],
      "properties": {
        "profile_name": {
          "type": "string",
          "minLength": 1
        },
        "allowed_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "baseline",
              "cheap",
              "heavy",
              "milestone",
              "device",
              "smoke"
            ]
          }
        },
        "allowed_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "denied_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_single_command_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_commands": {
          "type": "integer",
          "minimum": 1
        },
        "network_policy": {
          "type": "string",
          "enum": [
            "disabled",
            "allowlisted",
            "open"
          ]
        },
        "writable_roots": {
          "$ref": "#/$defs/pathList"
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contextFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prd_markdown_path",
        "prd_json_path",
        "template_fit_report_path",
        "implementation_plan_path"
      ],
      "properties": {
        "prd_markdown_path": {
          "type": "string",
          "minLength": 1
        },
        "prd_json_path": {
          "type": "string",
          "minLength": 1
        },
        "template_fit_report_path": {
          "type": "string",
          "minLength": 1
        },
        "implementation_plan_path": {
          "type": "string",
          "minLength": 1
        },
        "manual_constraints_path": {
          "type": "string",
          "minLength": 1
        },
        "supporting_files": {
          "$ref": "#/$defs/pathList"
        }
      }
    }
  }
}