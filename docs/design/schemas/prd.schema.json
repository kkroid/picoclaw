{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneappfactory.local/docs/design/schemas/prd.schema.json",
  "title": "OneAppFactory Product Requirements Document",
  "description": "OneAppFactory 产品研发编排平台使用的结构化 PRD。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "title",
    "summary",
    "problem_statement",
    "target_users",
    "core_scenarios",
    "goals",
    "non_goals",
    "feature_list",
    "screen_list",
    "user_flows",
    "data_entities",
    "template_constraints",
    "acceptance_criteria",
    "manual_review_points",
    "known_unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1
    },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/userProfile"
      }
    },
    "core_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "screen_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/screen"
      }
    },
    "user_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/userFlow"
      }
    },
    "data_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataEntity"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/integration"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "asset_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetRequirement"
      }
    },
    "template_constraints": {
      "$ref": "#/$defs/templateConstraints"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "manual_review_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/manualReviewPoint"
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knownUnknown"
      }
    },
    "execution_contract": {
      "$ref": "#/$defs/executionContract"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "userProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "label",
        "summary"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "pain_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "title",
        "summary"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "primary_user_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "title",
        "summary",
        "priority",
        "required"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "related_scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_screens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen_id",
        "name",
        "purpose"
      ],
      "properties": {
        "screen_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "primary_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "userFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "title",
        "steps"
      ],
      "properties": {
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/flowStep"
          }
        }
      }
    },
    "flowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "title"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "screen_ref": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "name",
        "fields"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataField"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_id",
        "name",
        "kind",
        "required"
      ],
      "properties": {
        "integration_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "api",
            "auth",
            "analytics",
            "payment",
            "storage",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reason",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "assetRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "type",
        "required",
        "description"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "icon",
            "splash",
            "illustration",
            "copy",
            "image",
            "audio",
            "video",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "templateConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "android_required",
        "required_capabilities"
      ],
      "properties": {
        "stack": {
          "type": "string",
          "enum": [
            "flutter",
            "react-native",
            "kotlin-compose",
            "other"
          ]
        },
        "android_required": {
          "type": "boolean"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_licenses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preferred_template_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "label",
        "category",
        "required"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "functional",
            "ui",
            "build",
            "smoke",
            "manual",
            "security",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "executionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "domain_model",
        "surface_contracts",
        "key_flows",
        "acceptance_matrix",
        "task_projection"
      ],
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "domain_model": {
          "$ref": "#/$defs/executionDomainModel"
        },
        "surface_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surfaceContract"
          }
        },
        "key_flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/keyFlow"
          }
        },
        "acceptance_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptanceMatrixItem"
          }
        },
        "task_projection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taskProjectionItem"
          }
        }
      }
    },
    "executionDomainModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_name",
        "entities",
        "summary_metrics"
      ],
      "properties": {
        "domain_name": {
          "type": "string",
          "minLength": 1
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataEntity"
          }
        },
        "summary_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "critical_flow_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "surfaceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "surface_ref",
        "purpose"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_ref": {
          "type": "string",
          "minLength": 1
        },
        "template_binding_ref": {
          "type": "string",
          "minLength": 1,
          "description": "prepare 从 template-slot-map.json.slots[].binding_id 选中的公共绑定引用；不再回退到模板私有 slot_id。"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "primary_feature_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_entity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surfaceContractAction"
          }
        },
        "required_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surfaceContractState"
          }
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "surfaceContractAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "label",
        "outcome"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surfaceContractState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "label",
        "evidence"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keyFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "title",
        "entry_surface_ref",
        "steps",
        "success_signals"
      ],
      "properties": {
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "entry_surface_ref": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/keyFlowStep"
          }
        },
        "write_entity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "read_entity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "keyFlowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "surface_ref",
        "action",
        "expected_result"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_ref": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptanceMatrixItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "acceptance_ref",
        "layer",
        "required"
      ],
      "properties": {
        "matrix_id": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_ref": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": [
            "structure",
            "semantic",
            "behavior",
            "delivery"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slot_refs": {
          "description": "当前仍沿用旧字段名，但内部值必须是公共 binding_id，而不是 template-slot-map 里的 slot_id。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "field_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "check_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taskProjectionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "wave",
        "lane",
        "task_type",
        "target_paths"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "integer",
          "minimum": 0
        },
        "lane": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "task_type": {
          "type": "string",
          "enum": [
            "single_file_edit",
            "dual_file_wiring",
            "analyze_repair",
            "test_repair",
            "closure_repair"
          ]
        },
        "route_hint": {
          "type": "string",
          "enum": [
            "deterministic",
            "default_model",
            "upgrade_model",
            "strong_model"
          ]
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relation_group_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_ownership_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_intent_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slot_refs": {
          "description": "当前仍沿用旧字段名，但内部值必须是公共 binding_id，而不是 template-slot-map 里的 slot_id。",
          "type": "array",
