{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picoclaw.local/docs/design/schemas/prd.schema.json",
  "title": "PicoClaw Product Requirements Document",
  "description": "PicoClaw 产品研发编排平台使用的结构化 PRD。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "title",
    "summary",
    "problem_statement",
    "target_users",
    "core_scenarios",
    "goals",
    "non_goals",
    "feature_list",
    "screen_list",
    "user_flows",
    "data_entities",
    "template_constraints",
    "acceptance_criteria",
    "manual_review_points",
    "known_unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1
    },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/userProfile"
      }
    },
    "core_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "screen_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/screen"
      }
    },
    "user_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/userFlow"
      }
    },
    "data_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataEntity"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/integration"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "asset_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetRequirement"
      }
    },
    "template_constraints": {
      "$ref": "#/$defs/templateConstraints"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "manual_review_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/manualReviewPoint"
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knownUnknown"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "userProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "label",
        "summary"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "pain_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "title",
        "summary"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "primary_user_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "title",
        "summary",
        "priority",
        "required"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "related_scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_screens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen_id",
        "name",
        "purpose"
      ],
      "properties": {
        "screen_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "primary_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "userFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "title",
        "steps"
      ],
      "properties": {
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/flowStep"
          }
        }
      }
    },
    "flowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "title"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "screen_ref": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "name",
        "fields"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataField"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_id",
        "name",
        "kind",
        "required"
      ],
      "properties": {
        "integration_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "api",
            "auth",
            "analytics",
            "payment",
            "storage",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reason",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "assetRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "type",
        "required",
        "description"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "icon",
            "splash",
            "illustration",
            "copy",
            "image",
            "audio",
            "video",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "templateConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "android_required",
        "required_capabilities"
      ],
      "properties": {
        "stack": {
          "type": "string",
          "enum": [
            "flutter",
            "react-native",
            "kotlin-compose",
            "other"
          ]
        },
        "android_required": {
          "type": "boolean"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_licenses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preferred_template_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "label",
        "category",
        "required"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "functional",
            "ui",
            "build",
            "smoke",
            "manual",
            "security",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manualReviewPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "summary",
        "reason"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "enum": [
            "product",
            "engineering",
            "design",
            "legal",
            "qa",
            "other"
          ]
        }
      }
    },
    "knownUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "impact"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "owner": {
          "type": "string",
          "enum": [
            "product",
            "engineering",
            "design",
            "qa",
            "other"
          ]
        }
      }
    }
  }
}