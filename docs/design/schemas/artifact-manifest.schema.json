{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneappfactory.local/docs/design/schemas/artifact-manifest.schema.json",
  "title": "OneAppFactory Builder Artifact Manifest",
  "description": "Builder 输出包中的产物清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "generated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactItem"
      }
    }
  },
  "$defs": {
    "artifactItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "artifact_type",
        "produced"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "apk",
            "aab",
            "screenshot",
            "log",
            "report",
            "checklist",
            "patch",
            "workspace-snapshot",
            "config",
            "other"
          ]
        },
        "produced": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}