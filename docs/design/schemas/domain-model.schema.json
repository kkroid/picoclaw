{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneappfactory.local/docs/design/schemas/domain-model.schema.json",
  "title": "OneAppFactory Domain Model",
  "description": "planning-engine 产出的领域语义模型快照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "prd_id",
    "template_id",
    "domain_name",
    "domain_copy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "prd_id": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "domain_name": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "./prd.schema.json#/$defs/dataEntity"
      }
    },
    "summary_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain_copy": {
      "$ref": "#/$defs/domainCopy"
    },
    "critical_flows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantic_acceptance_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticAcceptanceRule"
      }
    }
  },
  "$defs": {
    "domainCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "problem_statement"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "problem_statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semanticAcceptanceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "label",
        "description"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "field_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}