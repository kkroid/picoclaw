{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picoclaw.local/docs/design/schemas/builder-metrics.schema.json",
  "title": "PicoClaw Builder Metrics",
  "description": "Builder 输出包中的执行指标统计。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "total_iterations",
    "total_tokens",
    "duration_seconds",
    "command_runs",
    "failure_signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "total_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "completion_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "command_runs": {
      "type": "integer",
      "minimum": 0
    },
    "successful_checks": {
      "type": "integer",
      "minimum": 0
    },
    "failed_checks": {
      "type": "integer",
      "minimum": 0
    },
    "no_progress_hits": {
      "type": "integer",
      "minimum": 0
    },
    "model_request_retries": {
      "type": "integer",
      "minimum": 0
    },
    "model_request_failures": {
      "type": "integer",
      "minimum": 0
    },
    "model_unavailable_seconds": {
      "type": "number",
      "minimum": 0
    },
    "device_failure_categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deviceFailureCategory"
      }
    },
    "failure_signatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failureSignature"
      }
    }
  },
  "$defs": {
    "deviceFailureCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "failure_domain",
        "count"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "failure_domain": {
          "type": "string",
          "enum": [
            "device",
            "environment"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "failureSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature",
        "count",
        "last_stage"
      ],
      "properties": {
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "last_stage": {
          "type": "string",
          "enum": [
            "thin-prepare",
            "baseline",
            "cheap",
            "heavy",
            "milestone",
            "device",
            "smoke",
            "other"
          ]
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "sample_error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}