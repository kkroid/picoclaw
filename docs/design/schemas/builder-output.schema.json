{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneappfactory.local/docs/design/schemas/builder-output.schema.json",
  "title": "OneAppFactory Builder Output Package Manifest",
  "description": "Builder/Worker 回传给 OneAppFactory 的输出包主清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "status",
    "final_summary",
    "modified_files",
    "checks_passed",
    "checks_failed",
    "next_human_actions",
    "artifacts",
    "metrics",
    "report_paths"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "输出包 schema 版本。"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "escalated"
      ]
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "completed",
        "baseline_failed",
        "budget_exhausted",
        "no_progress",
        "model_unavailable",
        "environment_failure",
        "manual_escalation",
        "policy_blocked",
        "other"
      ]
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "final_summary": {
      "type": "string",
      "minLength": 1
    },
    "modified_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileChange"
      }
    },
    "checks_passed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "checks_failed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "next_human_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humanAction"
      }
    },
    "artifacts": {
      "$ref": "#/$defs/artifactSummary"
    },
    "metrics": {
      "$ref": "#/$defs/metricsSummary"
    },
    "report_paths": {
      "$ref": "#/$defs/reportPaths"
    },
    "resume_context": {
      "$ref": "#/$defs/resumeContext"
    }
  },
  "$defs": {
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "change_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "change_type": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "related_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "label",
        "stage",
        "outcome"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "thin-prepare",
            "baseline",
            "cheap",
            "heavy",
            "milestone",
            "device",
            "smoke",
            "manual",
            "other"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "waived"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "severity",
        "summary"
      ],
      "properties": {
        "blocker_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "resolution_hint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "humanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "summary",
        "reason"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "enum": [
            "product",
            "engineering",
            "qa",
            "ops",
            "design",
            "legal",
            "other"
          ]
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "primary_outputs"
      ],
      "properties": {
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "description": "artifact-manifest.json 的相对路径。"
        },
        "primary_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPointer"
          }
        }
      }
    },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "artifact_type"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "apk",
            "aab",
            "screenshot",
            "log",
            "report",
            "workspace-snapshot",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metricsSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics_path",
        "total_iterations",
        "total_tokens",
        "distinct_failure_signatures"
      ],
      "properties": {
        "metrics_path": {
          "type": "string",
          "minLength": 1,
          "description": "metrics.json 的相对路径。"
        },
        "total_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_failure_signatures": {
          "type": "integer",
          "minimum": 0
        },
        "no_progress_hits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reportPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_summary_path",
        "build_report_path",
        "smoke_test_report_path"
      ],
      "properties": {
        "change_summary_path": {
          "type": "string",
          "minLength": 1
        },
        "build_report_path": {
          "type": "string",
          "minLength": 1
        },
        "smoke_test_report_path": {
          "type": "string",
          "minLength": 1
        },
        "blockers_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resumeContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_snapshot_path": {
          "type": "string",
          "minLength": 1
        },
        "recommended_next_step": {
          "type": "string",
          "minLength": 1
        },
        "last_failure_signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}