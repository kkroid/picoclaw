{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picoclaw.local/docs/design/schemas/orchestrator-status.schema.json",
  "title": "PicoClaw Orchestrator Status Snapshot",
  "description": "workspace/appfactory/orchestrator/status.json 的最小结构基线。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "state",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "not_started",
        "idle",
        "running",
        "error"
      ]
    },
    "watch_runner_state": {
      "type": "string",
      "enum": [
        "not_running",
        "running"
      ]
    },
    "watch_runner_mode": {
      "type": "string",
      "enum": [
        "cli_watch",
        "internal_api_watch"
      ]
    },
    "watch_runner_owner_id": {
      "type": "string",
      "minLength": 1
    },
    "watch_runner_interval_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "watch_runner_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "watch_runner_stopped_at": {
      "type": "string",
      "format": "date-time"
    },
    "watch_runner_last_error": {
      "type": "string",
      "minLength": 1
    },
    "watch_lock_state": {
      "type": "string",
      "enum": [
        "unlocked",
        "held_by_self",
        "held_by_other"
      ]
    },
    "watch_lock_owner_id": {
      "type": "string",
      "minLength": 1
    },
    "watch_lock_mode": {
      "type": "string",
      "enum": [
        "cli_watch",
        "internal_api_watch"
      ]
    },
    "watch_lock_acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "watch_lock_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "watch_lock_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_trigger": {
      "type": "string",
      "minLength": 1
    },
    "last_pass_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_pass_finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "queued_recoveries": {
      "type": "integer",
      "minimum": 0
    },
    "running_recoveries": {
      "type": "integer",
      "minimum": 0
    },
    "foreign_live_lease_skips": {
      "type": "integer",
      "minimum": 0
    },
    "last_error": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}