FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FLUTTER_VERSION=3.29.3
ARG ANDROID_SDK_PLATFORM=android-35
ARG ANDROID_BUILD_TOOLS=35.0.0
ARG ANDROID_BUILD_TOOLS_COMPAT=34.0.0
ARG ANDROID_NDK_VERSION=27.0.12077973
ARG ANDROID_CMAKE_VERSION=3.22.1
ARG ANDROID_CMDLINE_TOOLS=13114758
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG NO_PROXY

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=Etc/UTC
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV FLUTTER_ROOT=/opt/flutter
ENV PUB_CACHE=/opt/pub-cache
ENV PATH=/root/.local/bin:/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/35.0.0:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV NO_PROXY=${NO_PROXY:-127.0.0.1,localhost,host.docker.internal}

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    libglu1-mesa \
    openjdk-17-jdk \
    openssh-client \
    rsync \
    unzip \
    wget \
    xz-utils \
    zip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt /workspace /artifacts /opt/android-sdk/cmdline-tools /opt/pub-cache

RUN curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
    | tar -xJ -C /opt

RUN git config --global --add safe.directory /opt/flutter

RUN curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS}_latest.zip" -o /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d /opt/android-sdk/cmdline-tools \
    && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
    && rm -f /tmp/cmdline-tools.zip

RUN yes | sdkmanager --licenses >/dev/null \
    && sdkmanager \
      "platform-tools" \
      "platforms;${ANDROID_SDK_PLATFORM}" \
    "build-tools;${ANDROID_BUILD_TOOLS}" \
    "build-tools;${ANDROID_BUILD_TOOLS_COMPAT}" \
    "cmake;${ANDROID_CMAKE_VERSION}" \
    "ndk;${ANDROID_NDK_VERSION}"

RUN flutter config --no-analytics \
    && flutter precache --android \
    && chmod -R a+rwX /opt/flutter/bin/cache /opt/pub-cache

COPY scripts/setup-appfactory-builder.sh /usr/local/bin/setup-appfactory-builder

RUN chmod +x /usr/local/bin/setup-appfactory-builder

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/setup-appfactory-builder"]
CMD ["doctor"]