FROM alpine:3.21

ARG TARGETPLATFORM

RUN apk add --no-cache ca-certificates docker-cli tzdata

ENV HOME=/root
ENV ONEAPPFACTORY_HOME=/root/.appfactory
ENV ONEAPPFACTORY_CONFIG=/root/.appfactory/config.json

COPY $TARGETPLATFORM/oneappfactory /usr/local/bin/oneappfactory
COPY $TARGETPLATFORM/oneappfactory-launcher /usr/local/bin/oneappfactory-launcher
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 18800

ENTRYPOINT ["/entrypoint.sh"]
